# This file contains configurations for the Text-to-SQL MCP Tool.
# Copy this file to .env and fill in the values.

# 1. LLM Provider Selection
# ---------------------------------
# Specify the LLM provider to use. Options: "openai", "ollama"
LLM_PROVIDER="ollama"


# 2. Database Connection
# ---------------------------------
DATABASE_URL=postgresql://open_webui_user:your_strong_password@localhost:5432/open_webui_db


# 3. LLM Provider Configuration
# ---------------------------------

# For OpenAI (used if LLM_PROVIDER="openai")
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo

# For local Ollama (used if LLM_PROVIDER="ollama")
OLLAMA_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3


# 4. Debugging
# ---------------------------------
# Set to true to include detailed debug info in the API response
DEBUG_MODE=false